<?xml version="1.0" encoding="utf-8"?>
<!--
  Android lets the app use plain http:// here; the app itself refuses it for anything except Tailscale, home-network
  and loopback addresses (see Api.requireSafeUrl). Public servers must use https://.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
